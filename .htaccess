# JDM Kenya Module Redirection Rules
RewriteEngine On

# JDM OAuth Environment Variables (Local Development)
SetEnv JDM_OAUTH_ENABLED true
SetEnv JDM_OAUTH_ISSUER http://127.0.0.1/JDM_kenya
SetEnv JDM_OAUTH_PRIVATE_KEY_PATH /home/cheroben/jdm-oauth-keys/private.key
SetEnv JDM_OAUTH_PUBLIC_KEY_PATH /home/cheroben/jdm-oauth-keys/public.key
SetEnv JDM_OAUTH_ENCRYPTION_KEY 4fFCFHDqU3A9RiknaVgKoBXbCNrheLMHr53Z+Yr4Cxk=
SetEnv JDM_OAUTH_AUDIT_SALT sjJUBq+ZGnmQE5HhQ0L5q+MNQXP1/r7ozKLfjhfVzAc=
SetEnv JDM_OAUTH_ALLOW_INSECURE_LOCAL true
SetEnv JDM_SESSION_COOKIE jdm_kenya_session

# Normalize requests that include a leftover "/JDM_kenya" prefix
RewriteRule ^JDM_kenya/(.*)$ /$1 [R=301,L,NE]
RewriteRule ^modules/auth/login\.php$ login.php [R=301,L]
RewriteRule ^modules/auth/signup\.php$ signup.php [R=301,L]
RewriteRule ^modules/auth/profile\.php$ profile.php [R=301,L]
RewriteRule ^modules/auth/logout\.php$ logout.php [R=301,L]
RewriteRule ^modules/public/about\.php$ about.php [R=301,L]
RewriteRule ^modules/public/activities\.php$ activities.php [R=301,L]
RewriteRule ^modules/public/contact\.php$ contact.php [R=301,L]
RewriteRule ^modules/public/index\.php$ index.php [R=301,L]
RewriteRule ^modules/public/login\.php$ login.php [R=301,L]
RewriteRule ^modules/public/resources\.php$ resources.php [R=301,L]
RewriteRule ^modules/portal/admin_dashboard\.php$ admin_dashboard.php [R=301,L]
RewriteRule ^modules/portal/member_dashboard\.php$ member_dashboard.php [R=301,L]
RewriteRule ^modules/portal/gallery\.php$ gallery.php [R=301,L]
RewriteRule ^modules/portal/directory\.php$ directory.php [R=301,L]
RewriteRule ^modules/portal/resources\.php$ resources.php [R=301,L]
RewriteRule ^modules/portal/members_portal\.php$ members_portal.php [R=301,L]
RewriteRule ^modules/portal/prayer_wall\.php$ prayer_wall.php [R=301,L]
RewriteRule ^modules/chat/chat\.php$ chat.php [R=301,L]
RewriteRule ^modules/chat/check_new_messages\.php$ check_new_messages.php [R=301,L]
RewriteRule ^modules/chat/mark_as_read\.php$ mark_as_read.php [R=301,L]
RewriteRule ^modules/sports/sports_admin\.php$ sports_admin.php [R=301,L]
RewriteRule ^modules/sports/sports_hub\.php$ sports.php [R=301,L]

# Performance: Cache static assets for 1 year
<FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# Performance: Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com 'unsafe-inline'; style-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none';"
</IfModule>

# Security: Prevent directory listing
Options -Indexes

# Security: Hide PHP version
ServerSignature Off

# Block access to sensitive files
<FilesMatch "\.(sql|md|log|env|local\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(config\.php|composer\.(json|lock)|package\.json|\.env(\..*)?)$">
    Require all denied
</FilesMatch>

# Block direct access to tmp/ directory (session files, debug logs)
<IfModule mod_rewrite.c>
    RewriteRule ^tmp/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^oauth/(bin|src|views)/ - [F,L]
</IfModule>

<FilesMatch "^(config(\.local)?\.php|setup(_local_db)?\.php|test.*\.php)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(?:\.git|\.agents|\.codex|database|tests?)(?:/|$)
