# ============================================================
# JDM Kenya — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — only commit this .env.example
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# --- Application ---
SITE_NAME="JDM Kenya"
SITE_URL=https://yourdomain.com

# --- Email (From Address) ---
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME="JDM Kenya"

# --- SMTP Settings ---
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_TIMEOUT=15

# --- OAuth (optional, leave defaults if not using OAuth) ---
JDM_OAUTH_ENABLED=false
JDM_OAUTH_ISSUER=https://yourdomain.com
JDM_OAUTH_PRIVATE_KEY_PATH=/secure/outside-public-html/jdm-oauth-private.key
JDM_OAUTH_PUBLIC_KEY_PATH=/secure/outside-public-html/jdm-oauth-public.key
JDM_OAUTH_ENCRYPTION_KEY=
JDM_OAUTH_AUDIT_SALT=
JDM_OAUTH_ALLOW_INSECURE_LOCAL=false

# --- Session ---
JDM_SESSION_COOKIE=jdm_kenya_session
