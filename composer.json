{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jdm-kenya/website",
    "description": "JDM Kenya website and OAuth 2.0 authorization server",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "~8.2.0",
        "laminas/laminas-diactoros": "^3.8",
        "league/oauth2-server": "^9.4",
        "paragonie/sodium_compat_ext_sodium": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Jdm\\OAuth\\": "oauth/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
